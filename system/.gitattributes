* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore
# .bat files must have Windows line endings or cmd.exe can jump to the wrong label
*.bat text eol=crlf
*.ps1 text eol=crlf
